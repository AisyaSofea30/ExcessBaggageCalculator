<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Gambar Background -->


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/img3"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#A4B0BA"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="About This App"
                android:textColor="#0D47A1"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Excess Baggage Fee Calculator helps passengers quickly compute excess luggage costs based on ticket class (Economy/Business) including mandatory 8% service tax."
                android:textColor="#0F0E0E"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Developer Details"
                android:textColor="#0D47A1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Name: NUR AISYA SOFEA BINTI BAKRI\nMatric No: 2024800226\nCourse: CDCS251"
                android:textColor="#000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGithubUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:autoLink="web"
                android:gravity="center"
                android:linksClickable="true"
                android:text="https://github.com/AisyaSofea30/ExcessBaggageCalculator"
                android:textColor="#000000"
                android:textColorLink="#000000"
                android:textSize="14sp" />

            <!-- BUTANG BACK (PENTING: ID android:id="@+id/btnBack") -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#0D47A1"
                android:text="Back to Main Menu"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>